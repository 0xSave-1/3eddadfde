# PostgreSQL (required)
DATABASE_URL=postgresql://nexora:change-me@localhost:5432/nexora

# Telegram (required for the live Mini App and bot webhook)
TELEGRAM_BOT_TOKEN=replace_with_token_from_BotFather
NEXT_PUBLIC_APP_URL=https://your-public-https-domain.example
TELEGRAM_SESSION_SECRET=replace_with_a_long_random_secret
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# Admin bootstrap. Do not reuse this password anywhere else.
ADMIN_PASSWORD=choose_a_long_unique_password
ADMIN_SESSION_SECRET=replace_with_a_different_long_random_secret
OWNER_TELEGRAM_ID=

# Stripe payments (required only when card payments / top-ups are enabled)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Enables ordinary-browser testing locally. Do not set this in production.
ALLOW_BROWSER_PREVIEW=true
